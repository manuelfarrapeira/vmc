# Configuración de seguridad para la carpeta API

# Bloquear listado de directorios
Options -Indexes

# Permitir acceso a archivos PHP de la API pero solo a través de peticiones HTTP
# No permitir acceso directo a archivos de debug o test
<FilesMatch "(debug|test|check_user|fix_password|generate_hash|quick_hash)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Permitir acceso a endpoints de producción
<FilesMatch "(health_check|verify_token)\.php$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>
